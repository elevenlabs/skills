#!/usr/bin/env python3
"""A stand-in for the ElevenLabs CLI's `onboard` steps, put on PATH by
evals/run_all.py for the onboarding and setup-api-key functional evals. Each
step prints the real CLI's reply (next, instruction, run, say, details, rules) for the
states the evals use: a laptop with no key yet, a key in the env file (always
accepted), an empty placeholder. Like the real CLI, it never reads the
project's code. It rejects flags the real step doesn't take. Other states (a
rejected key, a remote machine, a declined approval) are scripted per case.

A case can replace a step's reply with these variables (JSON; a list is
used one item per call, the last item repeating):

  ONBOARD_INIT_JSON  ONBOARD_CONNECT_JSON  ONBOARD_CHECK_JSON  ONBOARD_TEST_JSON

`init` (and `connect`, its older name) with the default reply writes a fake
key to the env file and gitignores it, as the real CLI does once the approval
page hands one over. The real one waits in the browser first; this one doesn't.
Every call is appended to $EVAL_DIR/outputs/elevenlabs-calls.txt with the
folder it ran in, followed by `-> <next>` for its reply, for grading.
"""
import json, os, re, sys, tempfile

args = sys.argv[1:]
EVAL_DIR = os.environ.get("EVAL_DIR", ".")
# The eval folder's outputs, wherever in it the agent runs this from.
OUTPUTS = os.path.join(EVAL_DIR, "outputs")
os.makedirs(OUTPUTS, exist_ok=True)
if "-h" in args or "--help" in args or args[1:2] == ["help"]:
    # Help is not a step: printed, and not logged as a call.
    print("Usage: elevenlabs onboard <init|check|test> [OPTIONS]")
    sys.exit(0)
with open(os.path.join(OUTPUTS, "elevenlabs-calls.txt"), "a") as log:
    log.write(f"elevenlabs {' '.join(args)} (in {os.path.relpath(os.getcwd(), EVAL_DIR)})\n")

# The flags each step takes, as the real CLI defines them; the framework adds the global ones.
# `--env-file` is the old name of `--env-path`, still accepted like the real CLI does. `--wait` and
# `--answered` are what replies from before this flow asked for: accepted, and they change nothing.
ENV = {"--env-path", "--env-file"}
KEY_STEP = ENV | {"--no-browser", "--replace", "--wait", "--authorize-url"}
FLAGS = {"init": KEY_STEP, "connect": KEY_STEP,
         "check": ENV | {"--no-browser", "--answered"}, "test": ENV | {"--no-browser"}}
GLOBAL_FLAGS = {"--format", "--human", "--base-url", "-q", "--quiet", "--debug", "--dry-run", "--via",
                "--query", "--schema", "--spec", "--spec-raw"}
# Flags followed by a value (unless given as --flag=value).
VALUE_FLAGS = {"--env-path", "--env-file", "--authorize-url", "--format", "--base-url", "--via", "--query"}
RULES = [
         "Never open, print or cat the env file; run `onboard check` to verify the key.",
         "Never ask for an API key in chat, and never accept one pasted there.",
         "Never put the key in code, or in anything that runs in the browser; the SDK reads ELEVENLABS_API_KEY.",
         "Never run git clean or delete untracked files.",
         "Put anything you download only to read, like a package or an archive, in a temp folder, never in the project.",
         "Don't run the app (or its start script) or make speech to try it until the user says yes to the test request. API calls that what they asked for needs, like creating an agent, are fine."]
FAKE_KEY = "sk_" + "0" * 40 + "4f2a"
# What the agent does with each reply, as the real CLI prints it.
INSTRUCTIONS = {
    "run": "Tell the user `say`, then run `run`.",
    "ask_user": "Ask the user what `say` says and wait for their answer, then run `run`, unless they said no.",
    "fix": "Do what `say` describes, then run `run`.",
    "integrate": "Tell the user `say`. The key is in place, so the rest is yours: build what the user asked for with ElevenLabs. Only a request that says what the app should do with ElevenLabs says what to build; one that asks to add, set up or use ElevenLabs, or for something general like voice features, doesn't. If theirs doesn't, ask `details.question`, as it is, and end your turn: write no code and install nothing until they answer, and don't pick for them. If they only want the SDK, install it (`details.sdk_install`) and create the client in one small file. Otherwise first run `details.fetch_skills`: it downloads the ElevenLabs skills into `details.skills_dir`, one folder per skill, outside the project, so list and read it with shell commands like `ls` and `cat` (file search tools may not look there). If one fits, read its SKILL.md and the `references/` files it links before writing any code, and write the code the way the skill shows, not from the SDK's own files; if none fits, write it without one. Install the SDK, and get the key to the code the way `details.load_key` says. If it needs something made in ElevenLabs first, like an agent, make it yourself with the key (load the env file in the command, never print it), and when you're done give the user the links in `details.agent_links` with its ID filled in. When the code is written (or if it already was), say what you set up, how to run it and anything the user still has to do themselves, like installing the packages you added. Then end your reply with `details.test_offer`, as it is, and end your turn. If they say yes, run `run`: that command is the test request, so don't run their app in its place. If they say no, run nothing.",
    "done": "Tell the user `say`, then anything they still have to do themselves, like installing the packages you added, in one or two concrete steps. There's nothing left to run."
}
CLI = "npx -y @elevenlabs/cli@latest" if os.environ.get("npm_command") == "exec" else "elevenlabs"
# Asked only when the developer hasn't said, so the agent never picks a product for them.
WHAT_TO_BUILD = "What would you like to build with ElevenLabs, or should I just add the SDK for now?"
TEST_OFFER = "Want me to send a test request? It makes a short text-to-speech clip with your key and uses a few credits."
SKILLS_ARCHIVE = "https://github.com/elevenlabs/skills/archive/refs/heads/main.tar.gz"


def flag(name):
    for i, a in enumerate(args):
        if a == name and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(name + "="):
            return a[len(name) + 1:]
    return None


def has(*files):
    return any(os.path.exists(f) for f in files)


def key_in(path):
    """The last key line's value, read the way dotenv loaders read it; None when there is no line."""
    try:
        lines = open(path, encoding="utf-8-sig").read().splitlines()
    except OSError:
        return None
    keys = []
    for line in lines:
        m = re.match(r"\s*(?:export\s+)?ELEVENLABS_API_KEY\s*=\s*(.*)$", line)
        if not m:
            continue
        value = m.group(1).strip()
        quoted = re.match(r"""(['"])(.*?)\1""", value)
        keys.append(quoted.group(2) if quoted else re.split(r"(?:^|\s+)#", value, maxsplit=1)[0].strip())
    return keys[-1] if keys else None


STACK = "node" if has("package.json") else "python" if has("pyproject.toml", "requirements.txt", "Pipfile", "setup.py") else "other"


def default_env_file():
    """`.env` for Python, `.env.local` otherwise; a key the project already keeps in its `.env` stays there."""
    default = ".env" if STACK == "python" else ".env.local"
    if default != ".env" and key_in(default) is None and key_in(".env") is not None:
        return ".env"
    return default


env_file = flag("--env-path") or flag("--env-file") or default_env_file()


def cmd(step):
    """The real CLI's next command: the env file always, and --no-browser when this run had it."""
    out = f"{CLI} onboard {step}"
    if "--env-path" not in step:
        out += f" --env-path {env_file}"
    if "--no-browser" in args:
        out += " --no-browser"
    return out


def store_key():
    """What the real CLI does once the approval page hands a key over."""
    lines = [l for l in (open(env_file).read().splitlines() if os.path.exists(env_file) else []) if not l.startswith("ELEVENLABS_API_KEY=")]
    with open(env_file, "w") as f:
        f.write("\n".join(lines + [f"ELEVENLABS_API_KEY={FAKE_KEY}"]) + "\n")
    with open(".gitignore", "a") as f:
        f.write("# Local secrets written by `elevenlabs onboard`\n/" + env_file + "\n")


def reply(next_, say, run=None, rules=True, **details):
    out = {"next": next_, "instruction": INSTRUCTIONS[next_]}
    if run:
        out["run"] = run
    out["say"] = say
    if rules:
        out["rules"] = RULES
    if details:
        out["details"] = details
    return out


def integrate(key, say, **more):
    """The real CLI's one reply once a working key is in place: where the key is, what the app needs
    to load it, where the skills are, and the test request to offer at the end."""
    install = {"python": "pip install elevenlabs (and add elevenlabs to the project's dependencies)",
               "node": "npm install @elevenlabs/elevenlabs-js"}.get(
        STACK, "npm install @elevenlabs/elevenlabs-js (or pip install elevenlabs, and add elevenlabs to requirements.txt)")
    skills = tempfile.mkdtemp(prefix="elevenlabs-skills-")
    archive = os.path.join(skills, "skills.tar.gz")
    load_key = ("The SDK reads ELEVENLABS_API_KEY from the environment. "
                f"It is in {env_file}, so make sure the app loads that file into its environment before the SDK is "
                "imported: many frameworks only read `.env` on their own, and some read env files into their own "
                "object instead of the process environment. Keep the key in server-side code: never in the source, "
                "and never in anything that runs in the browser.")
    return reply("integrate", say, cmd("test"), key_last4=key[-4:], env_file=env_file, question=WHAT_TO_BUILD,
                 sdk_install=install, load_key=load_key, skills_dir=skills,
                 fetch_skills=f"curl -fsSL -o {archive} {SKILLS_ARCHIVE} && tar -xzf {archive} -C {skills} --strip-components=1",
                 agent_links="Its page: https://elevenlabs.io/app/agents/agents/<agent_id>. To talk to it, when anyone "
                             "with the link may: https://elevenlabs.io/app/talk-to?agent_id=<agent_id>.",
                 test_offer=TEST_OFFER, **more)


def scripted(step):
    """The case's reply for this step, if it set one; a list is consumed one per call."""
    raw = os.environ.get(f"ONBOARD_{step.upper()}_JSON")
    if not raw:
        return None
    value = json.loads(raw)
    if isinstance(value, list):
        counter = os.path.join(OUTPUTS, f".{step}-calls")
        n = int(open(counter).read()) if os.path.exists(counter) else 0
        open(counter, "w").write(str(n + 1))
        value = value[min(n, len(value) - 1)]
    # Every real reply says what to do with it.
    if isinstance(value, dict) and value.get("next") in INSTRUCTIONS:
        value.setdefault("instruction", INSTRUCTIONS[value["next"]])
    return value


def emit(obj, code=0):
    with open(os.path.join(OUTPUTS, "elevenlabs-calls.txt"), "a") as log:
        log.write(f"  -> {obj.get('next', 'error')}\n")
    # The real CLI prints its keys sorted.
    print(json.dumps(obj, indent=2, sort_keys=True))
    sys.exit(code)


def refuse(message):
    """The real CLI's usage error: JSON on stdout, exit 3."""
    with open(os.path.join(OUTPUTS, "elevenlabs-calls.txt"), "a") as log:
        log.write("  -> error\n")
    print(json.dumps({"error": {"code": 400, "message": message, "reason": "validationError",
                                "usage": f"elevenlabs onboard {step} [OPTIONS]"}}, indent=2))
    sys.exit(3)


if args[:1] != ["onboard"] or len(args) < 2:
    print("elevenlabs stand-in: only `onboard init|check|test` is available", file=sys.stderr)
    sys.exit(2)
step = "check" if args[1] == "status" else args[1]
if step not in FLAGS:
    print(f"elevenlabs stand-in: unknown step {step!r}", file=sys.stderr)
    sys.exit(2)
rest = iter(args[2:])
for a in rest:
    name = a.split("=", 1)[0]
    if not name.startswith("-") or name not in FLAGS[step] | GLOBAL_FLAGS:
        refuse(f"unexpected argument '{name}' found")
    if name in VALUE_FLAGS and "=" not in a:
        next(rest, None)
own = scripted(step)
if own:
    # A scripted sign-in that created a key stores it, as the real one does.
    if step in ("init", "connect") and (own.get("details") or {}).get("key_status") == "created":
        store_key()
    emit(own)

key = key_in(env_file)


def works(key):
    """The reply for a key that is there and works: the same one that hands the rest over."""
    return integrate(key, f"Your ElevenLabs key ending in {key[-4:]} works. It's in {env_file}.",
                     api_key_source="env_file", fixed=[])


if step in ("init", "connect"):
    # A key already there is checked and kept; otherwise this step is the sign-in.
    if key and "--replace" not in args:
        emit(works(key))
    store_key()
    emit(integrate(FAKE_KEY, f"Signed in. Your new key ending in {FAKE_KEY[-4:]} is in {env_file}, and your clipboard was cleared.",
                   key_status="created", gitignored=True))
if step == "check":
    if key is None:
        approval = "I'll give you a link to the approval page" if "--no-browser" in args else "I'll open the approval page"
        emit(reply("run", f"There's no ElevenLabs API key in this project yet, so {approval} to create one.", cmd("connect")))
    if key == "":
        emit(reply("ask_user", f"ELEVENLABS_API_KEY in {env_file} is still empty. Paste the key after the = (never into this chat), and tell me when it's done.", cmd("check")))
    emit(works(key))
if step == "test":
    if not key:
        emit(reply("run", "There's no ElevenLabs API key in this project yet.", cmd("check"), rules=False))
    emit(reply("done", "Your first request worked. Play /tmp/elevenlabs-hello-1a2b3c.mp3 to hear it. "
               f"ElevenLabs is set up: your key is in {env_file}.", rules=False,
               audio_file="/tmp/elevenlabs-hello-1a2b3c.mp3", status=200))
